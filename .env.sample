# Настройки в файле settings.py джанго
# Настройки джанго
SECRET_KEY=

DEBUG=

# Настройки БД в джанго
NAME=
USER=
PASSWORD=
HOST=
PORT=


# Настройки email
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# Настройки телеграм бота
BOT_NAME=
BOT_TOKEN=
SITE_BASE_URL=http://localhost:8000
TELEGRAM_LOG_CHAT_ID=
CORS_ALLOWED_ORIGINS=http://localhost:8000
TELEGRAM_ADMIN_IDS=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Настройки AI-анализатора документов
# Базовый URL сервиса анализа документов (в коде используется POST {URL}/v1/analyze)
DOCS_ANALYZER_URL=http://192.168.0.4:8001
# Таймаут HTTP-запроса к анализатору в секундах
DOCS_ANALYZER_TIMEOUT_SEC=180
# Размер батча документов, который оркестратор отправляет в одну задачу анализа
DOCS_ANALYZER_BATCH_SIZE=3
# Желаемая конкуррентность обработки URL внутри AI-сервиса (поле options.concurrency)
DOCS_ANALYZER_CONCURRENCY=2
# Верхняя граница URL в одном запросе к AI-сервису (поле options.max_urls)
DOCS_ANALYZER_MAX_URLS=3
# TTL signed URL в секундах для fallback-режима через Django endpoint (filesystem)
DOCS_ANALYZER_SIGNED_URL_TTL_SEC=300
# Максимум повторов Celery-задачи при сетевых/openai ошибках
DOCS_ANALYZER_RETRY_MAX=1
# Базовая задержка (сек) для backoff между retry (дальше умножается 2^n)
DOCS_ANALYZER_RETRY_BACKOFF_SEC=15
# Jitter (сек), добавляемый к backoff для рассинхронизации повторов
DOCS_ANALYZER_RETRY_JITTER_SEC=5
# Rate limit Celery task для analyze_documents_batch_task
DOCS_ANALYZER_TASK_RATE_LIMIT=10/m
# Глобальный лимит документов в минуту (0 = выключено)
DOCS_ANALYZER_DOCS_PER_MIN_LIMIT=120
# Глобальный лимит токенов в минуту (0 = выключено)
DOCS_ANALYZER_TOKENS_PER_MIN_LIMIT=0
# Оценка токенов на один документ для budget guard
DOCS_ANALYZER_TOKENS_PER_DOC_ESTIMATE=3000
# Задержка при срабатывании budget guard (сек)
DOCS_ANALYZER_BUDGET_BACKOFF_SEC=20
# Дополнительный jitter к budget backoff (сек)
DOCS_ANALYZER_BUDGET_BACKOFF_JITTER_SEC=5
# Имя Celery-очереди для задач анализа документов
CELERY_QUEUE_DOCS_ANALYSIS=docs_analysis
# Ack late + prefetch=1 чтобы не забирать сразу много тяжелых задач
CELERY_TASK_ACKS_LATE=True
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_REJECT_ON_WORKER_LOST=True
# Префикс каталога в storage/bucket для автосинхронизации документов в модель Document
DOCS_STORAGE_SYNC_PREFIX=documents
# Автоматически запускать sync_documents_from_storage_task при старте web-процесса (по умолчанию выключено)
DOCS_SYNC_ON_STARTUP=False
# Минимальный интервал (сек) между автозапусками sync при старте web-процессов
DOCS_SYNC_STARTUP_COOLDOWN_SEC=180
# Включает периодический авто-поиск документов на анализ через Celery Beat (по умолчанию выключено)
DOCS_AI_ORCHESTRATOR_ENABLED=False
# Количество файлов в одном HTTP-запросе при массовой загрузке (frontend chunk upload)
DOCS_BULK_UPLOAD_CHUNK_SIZE=20
