# =========================
# Django / Core
# =========================
SECRET_KEY=  # Django SECRET_KEY
DEBUG=  # True/False
SITE_BASE_URL=http://localhost:8000  # базовый URL приложения
CORS_ALLOWED_ORIGINS=http://localhost:8000  # CSV origins

# =========================
# Database
# =========================
NAME=  # PostgreSQL DB name
USER=  # PostgreSQL user
PASSWORD=  # PostgreSQL password
HOST=  # PostgreSQL host
PORT=  # PostgreSQL port

# =========================
# Email (mail.ru SMTP)
# =========================
EMAIL_HOST_USER=  # SMTP login
EMAIL_HOST_PASSWORD=  # SMTP password

# =========================
# Telegram Bot
# =========================
BOT_NAME=  # bot display name
BOT_TOKEN=  # Telegram bot token
TELEGRAM_LOG_CHAT_ID=  # chat_id для ошибок логгера
TELEGRAM_ADMIN_IDS=  # CSV tg_id администраторов

# Telegram document import
TELEGRAM_DOC_IMPORT_ENABLED=False  # включить импорт документов из чата
TELEGRAM_DOC_IMPORT_CHAT_IDS=  # CSV chat_id, например -100123,-100456
TELEGRAM_DOC_IMPORT_ALLOWED_EXTENSIONS=pdf,doc,docx  # допустимые расширения
TELEGRAM_DOC_IMPORT_MAX_SIZE_MB=20  # максимальный размер файла, МБ
TELEGRAM_DOC_IMPORT_DEDUPLICATE=True  # дедупликация по hash+size
TELEGRAM_DOC_IMPORT_HTTP_TIMEOUT_SEC=30  # timeout запросов к Telegram API

# =========================
# Celery / Redis
# =========================
CELERY_BROKER_URL=redis://redis:6379/0  # брокер
CELERY_RESULT_BACKEND=redis://redis:6379/0  # backend результатов
CELERY_QUEUE_DOCS_ANALYSIS=docs_analysis  # отдельная очередь анализа документов
CELERY_TASK_ACKS_LATE=True  # подтверждать задачу после выполнения
CELERY_WORKER_PREFETCH_MULTIPLIER=1  # prefetch для тяжелых задач
CELERY_TASK_REJECT_ON_WORKER_LOST=True  # вернуть задачу в очередь при падении worker

# =========================
# Documents AI Analyzer
# =========================
DOCS_ANALYZER_URL=http://192.168.0.4:8001  # POST {URL}/v1/analyze
DOCS_ANALYZER_TIMEOUT_SEC=180  # timeout HTTP-запроса к анализатору
DOCS_ANALYZER_BATCH_SIZE=3  # размер батча для одной задачи анализа
DOCS_ANALYZER_CONCURRENCY=2  # options.concurrency для AI-сервиса
DOCS_ANALYZER_MAX_URLS=3  # options.max_urls для AI-сервиса
DOCS_ANALYZER_SIGNED_URL_TTL_SEC=300  # TTL signed URL, сек
DOCS_ANALYZER_RETRY_MAX=1  # максимум retry analyze task
DOCS_ANALYZER_RETRY_BACKOFF_SEC=15  # базовый backoff retry, сек
DOCS_ANALYZER_RETRY_JITTER_SEC=5  # jitter retry, сек
DOCS_ANALYZER_TASK_RATE_LIMIT=10/m  # rate limit analyze_documents_batch_task
DOCS_ANALYZER_DOCS_PER_MIN_LIMIT=120  # лимит документов/мин (0 = off)
DOCS_ANALYZER_TOKENS_PER_MIN_LIMIT=0  # лимит токенов/мин (0 = off)
DOCS_ANALYZER_TOKENS_PER_DOC_ESTIMATE=3000  # оценка токенов на документ
DOCS_ANALYZER_BUDGET_BACKOFF_SEC=20  # ожидание при budget guard, сек
DOCS_ANALYZER_BUDGET_BACKOFF_JITTER_SEC=5  # jitter для budget guard, сек

# =========================
# Documents Sync / Orchestrator
# =========================
DOCS_STORAGE_SYNC_PREFIX=documents  # префикс каталога в storage/bucket
DOCS_SYNC_ON_STARTUP=False  # запускать sync при старте web-процесса
DOCS_SYNC_STARTUP_COOLDOWN_SEC=180  # минимальный интервал автосинка, сек
DOCS_AI_ORCHESTRATOR_ENABLED=False  # включить периодический enqueue через beat
DOCS_BULK_UPLOAD_CHUNK_SIZE=20  # chunk size массовой загрузки (frontend)

# =========================
# Integrations / Webhooks
# =========================
ONLINE_RESULTS_WEBHOOK_SECRET=change_me
ONLINE_RESULTS_WEBHOOK_PUBLIC_BASE_URL=http://host.docker.internal:8000  # внешний base URL sport_school, доступный контейнеру online_results
ONLINE_RESULTS_STREAM_START_URL=http://localhost:8002/v1/streams
ONLINE_RESULTS_STREAM_STOP_URL_TEMPLATE=http://localhost:8002/v1/streams/{stream_id}/stop  # шаблон URL остановки потока
ONLINE_RESULTS_STREAM_TIMEOUT_SEC=15
ONLINE_RESULTS_STREAM_AUTH_TOKEN=  # Bearer token, если требуется
ONLINE_RESULTS_STREAM_POLL_INTERVAL_SEC=1.0
ONLINE_RESULTS_STREAM_REFRESH_TITLES_EVERY=120
ONLINE_RESULTS_STREAM_FINALIZE_TIMEOUT_SEC=300
ONLINE_RESULTS_STREAM_FINALIZE_MAX_MISSING=2
ONLINE_RESULTS_STREAM_WORKER_PRINT=False
ONLINE_RESULTS_STREAM_RESUME_STALE_SEC=180
ONLINE_RESULTS_STREAM_PENDING_TIMEOUT_SEC=45
